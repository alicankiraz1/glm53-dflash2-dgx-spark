{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/glm53-dflash2-dgx-spark/cluster.schema.json",
  "title": "GLM-5.3 four-node cluster configuration",
  "description": "Doctor requires free storage for the locked target Hub bytes and draft tensor bytes plus 20% headroom on every node; the Python loader additionally enforces canonical IPv4 network CIDR notation and restricts every remote path to a metacharacter-free absolute POSIX charset so shell, ssh, and rsync cannot reinterpret it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ssh",
    "fabric",
    "nodes",
    "ports"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_hosts_file",
        "fabric_known_hosts_file",
        "connect_timeout_seconds",
        "command_timeout_seconds"
      ],
      "properties": {
        "known_hosts_file": {
          "type": "string",
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        "fabric_known_hosts_file": {
          "type": "string",
          "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "connect_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "command_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "fabric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipv4_cidr",
        "require_rdma"
      ],
      "properties": {
        "ipv4_cidr": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
        },
        "require_rdma": {
          "const": true
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/rank0"
        },
        {
          "$ref": "#/$defs/rank1"
        },
        {
          "$ref": "#/$defs/rank2"
        },
        {
          "$ref": "#/$defs/rank3"
        }
      ],
      "items": false,
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "source"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "distributed"
      ],
      "properties": {
        "api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "distributed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "ssh_alias",
        "role",
        "remote_root",
        "fabric_ipv4",
        "hf_cache_root",
        "expected_machine_id_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ssh_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "role": {
          "enum": [
            "source",
            "worker"
          ]
        },
        "remote_root": {
          "type": "string",
          "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "fabric_ipv4": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"
        },
        "hf_cache_root": {
          "type": "string",
          "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "expected_machine_id_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rank0": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "rank": {
              "const": 0
            }
          }
        }
      ]
    },
    "rank1": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "rank": {
              "const": 1
            }
          }
        }
      ]
    },
    "rank2": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "rank": {
              "const": 2
            }
          }
        }
      ]
    },
    "rank3": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "rank": {
              "const": 3
            }
          }
        }
      ]
    }
  }
}
